EVENT IceNormalInfusion
ON
	OnCharacterStatusApplied(__Me, INF_ICE)
ACTIONS
  CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	Set(%Surface, SurfaceWaterFrozen)
	Set(%BlockingStatus, BURNING)
	Set(%BlockingStatus2, NECROFIRE)