#INCLUDE DefaultCharacter

INIT
	USING SHARED DefaultCharacter
	CHARACTER:__Me
	EXTERN INT:%bool_ShouldIgnoreOil=0
	EXTERN SURFACE:%Surface=SurfacePoison
	EXTERN STATUS:%BlockingStatus=BURNING
	EXTERN STATUS:%BlockingStatus2=NECROFIRE
	EXTERN FLOAT:%PuddleSize=0.5

EVENTS
EVENT OnShutdown_EndTimer
ON
	OnShutdown()
	OnDie(__Me,_,_,_)
ACTIONS
  CreateSurfaceAt(__Me,%Surface,2.5,5)
	StopTimer("CMB_ElementalSlug_CreateSurface_Timer")

EVENT OnInit_StartTimer
VARS
	CHARACTERTEMPLATE:_Temp
ON
	OnInit()
	OnCharacterStatusApplied(__Me, RESURRECT)
ACTIONS
	IF "!c1"
		CharacterIsDead(__Me)
	THEN
		StartTimer("CMB_ElementalSlug_CreateSurface_Timer",0.38,-1)
		CharacterEvent(__Me, "CMP_ResetBloodSurface")
    CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	ENDIF
// we could add a IsInSurface check here to prevent chain reactions, but I think it is intended that poison infusion creates constant explosion in fire, so only remove the surface on infusion itself
EVENT OnTimer_CreateSurface
ON
	OnTimer("CMB_ElementalSlug_CreateSurface_Timer")
ACTIONS
	IF "(c1&c2)|!(c3|c4)&(c5|!c6)"
		IsEqual(%BlockingStatus,null)					//c1
		IsEqual(%BlockingStatus2,null)					//c2
		CharacterHasStatus(__Me,%BlockingStatus)		//c3
		CharacterHasStatus(__Me,%BlockingStatus2)		//c4
		IsInActiveTurn(__Me)							//c5
		IsInCombat(__Me)								//c6
	THEN	
		CreateSurfaceAt(__Me,%Surface,%PuddleSize,5)
	ENDIF
//Change surfaces spawned on infusion
EVENT FireInfusion
ON
	OnCharacterStatusApplied(__Me, FireInfusion)
ACTIONS
  CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	Set(%Surface, SurfaceFire)
	Set(%BlockingStatus, POISONED)
	Set(%BlockingStatus2, NECROFIRE)
EVENT NecroFireInfusion
ON
	OnCharacterStatusApplied(__Me, NecrofireInfusion)
ACTIONS
  CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	Set(%Surface, SurfaceFireCursed)
	Set(%BlockingStatus, POISONED)
	Set(%BlockingStatus2, POISONED)
	
EVENT BlessedIceInfusion
ON
	OnCharacterStatusApplied(__Me, IceInfusion)
ACTIONS
  CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	Set(%Surface, SurfaceWaterFrozenBlessed)
	Set(%BlockingStatus, NECROFIRE)
	Set(%BlockingStatus2, NECROFIRE)

EVENT ElectricInfusion
ON
	OnCharacterStatusApplied(__Me, ElectricInfusion)
ACTIONS
  CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	Set(%Surface, SurfaceWaterElectrified)
	Set(%BlockingStatus, WET)
	Set(%BlockingStatus2, FROZEN)
	
EVENT PoisonInfusion
ON
	OnCharacterStatusApplied(__Me, PoisonInfusion)
ACTIONS
  CreateSurfaceAt(__Me,"SurfaceNone",1.25,1)
	Set(%Surface, SurfacePoison)
	Set(%BlockingStatus, BURNING)
	Set(%BlockingStatus2, NECROFIRE)

