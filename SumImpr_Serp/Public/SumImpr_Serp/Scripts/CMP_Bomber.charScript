INIT
	CHARACTER:__Me
	EXTERN SKILL:%DieOnCast=Shout_SuicideBomberExplosion
	EXTERN SKILL:%SkillOnDeath=Projectile_EnemySuicideBomberExplosion
	INT:%CastSkillOnDeath=1
	
EVENTS
EVENT DieOnCast
ON
	OnSkillCast(__Me, %DieOnCast)
ACTIONS
	Set(%CastSkillOnDeath, 0)
	CharacterDie(__Me)
	
EVENT ExplodeOnDeath
ON
	OnDie(__Me,_,_,_)
ACTIONS
	IF "c1"
		IsEqual(%CastSkillOnDeath,1)
	THEN
		ExplodeAt(__Me, %SkillOnDeath)
	ENDIF

EVENT FireInfusion
ON
	OnCharacterStatusApplied(__Me, FireInfusion)
ACTIONS
	Set(%DieOnCast, Shout_SuicideBomberExplosion)
	Set(%SkillOnDeath, Projectile_EnemySuicideBomberExplosion)
	
EVENT NecroFireInfusion
ON
	OnCharacterUsedSkillOnMe(_, Target_NecrofireInfusion)
ACTIONS
	Set(%DieOnCast, Shout_Summon_SuicideBomberNecrofire)
	Set(%SkillOnDeath, Projectile_Summon_BomberProjectile_Necrofire)
	
EVENT BlessedIceInfusion
ON
	OnCharacterUsedSkillOnMe(_, Target_IceInfusion)
ACTIONS
	Set(%DieOnCast, Shout_Summon_SuicideBomberBlessedIce)
	Set(%SkillOnDeath, Projectile_Summon_BomberProjectile_Ice)

EVENT ElectricInfusion
ON
	OnCharacterUsedSkillOnMe(_, Target_ElectricInfusion)
ACTIONS
	Set(%DieOnCast, Shout_Summon_SuicideBomberElectric)
	Set(%SkillOnDeath, Projectile_Summon_BomberProjectile_Electric)
	
