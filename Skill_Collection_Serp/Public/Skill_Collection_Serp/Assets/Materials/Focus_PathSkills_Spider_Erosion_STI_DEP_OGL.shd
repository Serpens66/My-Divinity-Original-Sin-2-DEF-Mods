[Vertex shader]

#version 150
#extension GL_ARB_shading_language_include : enable
#include "/Shaders/GLSL3/CommonHelpers.shdh"
#include "/Shaders/GlobalConstants_OGL.shdh"

in vec3 inPosition0;
in vec4 inColor1;
in vec4 inColor2;
in vec4 inColor3;
in vec2 inTexCoord0;

out vec4 Position0;
out vec2 TexCoord0;

void main()
{
	//Create Instance World Matrix
	vec4 col1 = vec4(inColor1.x, inColor1.y, inColor1.z, 0.0f);
	vec4 col2 = vec4(inColor1.w, inColor2.x, inColor2.y, 0.0f);
	vec4 col3 = vec4(inColor2.z, inColor2.w, inColor3.x, 0.0f);
	vec4 col4 = vec4(inColor3.y, inColor3.z, inColor3.w, 1.0f);
	mat4x4 WorldMatrix = mat4x4(col1, col2, col3, col4);

	//World space position
	vec4 worldPosition = (WorldMatrix * vec4(inPosition0, 1.0f));

	//Projected position
	vec4 projectedPosition = (global_ViewProjection * worldPosition);

	//Pass projected position to pixel shader
	Position0 = projectedPosition;

	TexCoord0 = inTexCoord0;
	gl_Position = Position0;
}


[Fragment shader]

#version 150
#extension GL_ARB_shading_language_include : enable
#include "/Shaders/GLSL3/CommonHelpers.shdh"

in vec4 Position0;
in vec2 TexCoord0;


uniform vec2 Vector2Parameter_ErosionCloudUV;
uniform sampler2D Texture2DParameter_ErosionCloud_DefaultWrapSampler;
uniform vec4 _MeshVertexColor;
uniform float FloatParameter_ErosionGlowSize;

void CalculateMatOpacity(vec2 in_0,
	out float out_0)
{
	vec2 Local0 = (in_0 * Vector2Parameter_ErosionCloudUV);
	vec4 Local1 = texture(Texture2DParameter_ErosionCloud_DefaultWrapSampler, Local0);
	//[Local1] Get needed components
	float Local2 = Local1.x;
	float Local3 = (1.0f + FloatParameter_ErosionGlowSize);
	float Local4 = (_MeshVertexColor.w * Local3);
	float Local5 = (Local4 - FloatParameter_ErosionGlowSize);
	float Local6 = (1.0f - Local5);
	float Local7 = (Local6 - FloatParameter_ErosionGlowSize);
	float Local8 = smoothstep(Local7, Local6, Local2);
	out_0 = Local8;
}

void main()
{
	float matOpacity;
	CalculateMatOpacity(TexCoord0, matOpacity);
	if((matOpacity - 0.5f) < 0) discard;

}
